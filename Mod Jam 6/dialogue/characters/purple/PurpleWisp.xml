<DialogueTree xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/xen-42/outer-wilds-new-horizons/main/NewHorizons/Schemas/dialogue_schema.xsd">
  <NameField>PH_PurpleWisp_NAME</NameField>

  <!-- Base ("ONE") -->
  <DialogueNode>
    <Name>DefaultNode</Name>
    <EntryCondition>DEFAULT</EntryCondition>
    <Dialogue>
	  <Page>PH_brevity_WISP_ONE_1a</Page>
      <Page>PH_prose_WISP_ONE_1a</Page>
	  <Page>PH_haiku_WISP_ONE_1a</Page>

      <Page>PH_prose_WISP_ONE_2b</Page>
      <Page>PH_prose_WISP_ONE_3c</Page>
    </Dialogue>
  </DialogueNode>

  <!-- Just Echo (one of the versions of "TWO") -->
  <DialogueNode>
    <Name>TwoEcho</Name>
    <EntryCondition>PH_TEMP_PURPLEECHO</EntryCondition>
    <Dialogue>
      <Page>PH_prose_WISP_ONE_1a</Page>
      <Page>PH_prose_WISP_TWO_EITHER_1a</Page>

      <Page>PH_prose_WISP_TWO_ECHO_1b</Page>
      <Page>PH_prose_WISP_TWO_ECHO_2c</Page>
    </Dialogue>
  </DialogueNode>

  <!-- Just Ripple (one of the versions of "TWO") -->
  <DialogueNode>
    <Name>TwoRipple</Name>
    <EntryCondition>PH_TEMP_PURPLERIPPLE</EntryCondition>
    <Dialogue>
      <Page>PH_prose_WISP_ONE_1a</Page>
      <Page>PH_prose_WISP_TWO_EITHER_1a</Page>

      <Page>PH_prose_WISP_TWO_RIPPLE_1B</Page>
      <Page>PH_prose_WISP_TWO_RIPPLE_2C</Page>
    </Dialogue>
  </DialogueNode>

  <!-- Both Echo abd Ripple ("THREE") -->
  <DialogueNode>
    <Name>Three</Name>
    <EntryCondition>PH_TEMP_PURPLECOMPLETE</EntryCondition>
    <Dialogue>
      <Page>PH_prose_WISP_ONE_1a</Page>
      <Page>PH_prose_WISP_TWO_EITHER_1a</Page>
      <Page>PH_prose_WISP_THREE_1a</Page>

      <Page>PH_prose_WISP_THREE_2b</Page>
      <Page>PH_prose_WISP_THREE_3c</Page>
    </Dialogue>
  </DialogueNode>
</DialogueTree>