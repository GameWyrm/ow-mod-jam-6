<DialogueTree xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/xen-42/outer-wilds-new-horizons/main/NewHorizons/Schemas/dialogue_schema.xsd">
  <NameField>PH_PurpleRipple_NAME</NameField>

  <!-- 01 -->
  <DialogueNode>
    <Name>DefaultNode</Name>
    <EntryCondition>DEFAULT</EntryCondition>
    <Dialogue>
      <Page>PH_prose_RIPPLE01_1</Page>
    </Dialogue>
    <SetPersistentCondition>PH_PURPLE_RIPPLE_P</SetPersistentCondition>
    <DialogueOptionsList>
      <DialogueOption>
        <Text>PH_prose_RIPPLE01_A</Text>
        <DialogueTarget>02</DialogueTarget>
      </DialogueOption>
      <DialogueOption>
        <Text>PH_prose_RIPPLE01_B</Text>
        <DialogueTarget>03</DialogueTarget>
      </DialogueOption>
    </DialogueOptionsList>

  </DialogueNode>

  <!-- 02 (Yes choice) -->
  <DialogueNode>
    <Name>02</Name>
    <Dialogue>
      <Page>PH_prose_RIPPLE02_1</Page>
    </Dialogue>
    <SetPersistentCondition>PH_FOUND_SOMETHING_P</SetPersistentCondition>
    <DialogueTarget>04</DialogueTarget>
  </DialogueNode>

  <!-- 03 (No choice) -->
  <DialogueNode>
    <Name>03</Name>
    <Dialogue>
      <Page>PH_prose_RIPPLE03_1</Page>
    </Dialogue>
    <SetPersistentCondition>PH_FOUND_SOMETHING_P</SetPersistentCondition>
    <DialogueTarget>04</DialogueTarget>
  </DialogueNode>

  <!-- 04 (Common ending) -->
  <DialogueNode>
    <Name>04</Name>
    <Dialogue>
      <Page>PH_prose_RIPPLE04_1</Page>
    </Dialogue>

    <RevealFacts>
      <FactID>PH_LOG_PURPLE_PROSE_CURIOSITY_RUMOR_3</FactID>
      <FactID>PH_LOG_PURPLE_RIPPLE_1</FactID>
      <FactID>PH_LOG_PURPLE_RIPPLE_2</FactID>
      <FactID>PH_LOG_PURPLE_RIPPLE_3</FactID>
    </RevealFacts>
    <SetPersistentCondition>PH_FOUND_GHOSTS_P</SetPersistentCondition>
    <SetCondition>PH_PURPLE_TALK</SetCondition>
  </DialogueNode>
  
</DialogueTree>