<DialogueTree xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/xen-42/outer-wilds-new-horizons/main/NewHorizons/Schemas/dialogue_schema.xsd">
  <NameField>PH_BlueWisp_NAME</NameField>

  <!-- Base ("ONE") -->
  <DialogueNode>
    <Name>DefaultNode</Name>
    <EntryCondition>DEFAULT</EntryCondition>
    <Dialogue>
		  <Page>PH_brevity_WISP_ONE_1a</Page>
    </Dialogue>

    <RevealFacts>
      <FactID>PH_LOG_BLUE_BREVITY_CURIOSITY_RUMOR_1</FactID>
      <FactID>PH_LOG_BLUE_WISP_RUMOR_1</FactID>
      <FactID>PH_LOG_BLUE_WISP_1</FactID>
    </RevealFacts>
    <SetPersistentCondition>PH_FOUND_SOMETHING_P</SetPersistentCondition>
    <SetCondition>PH_BLUE_WISP_T</SetCondition>
    <DialogueTarget>DefaultNode2</DialogueTarget>
  </DialogueNode>

  <DialogueNode>
    <Name>DefaultNode2</Name>
    <Dialogue>
      <Page>PH_brevity_WISP_ONE_2b</Page>
      <Page>PH_brevity_WISP_ONE_3c</Page>
    </Dialogue>
    <SetPersistentCondition>PH_FOUND_GHOSTS_P</SetPersistentCondition>
  </DialogueNode>

  <!-- Just Echo (one of the versions of "TWO") -->
  <DialogueNode>
    <Name>TwoEcho</Name>
    <EntryCondition>PH_BLUE_ECHO_P</EntryCondition>
    <Dialogue>
      <Page>PH_brevity_WISP_ONE_1a</Page>
      <Page>PH_brevity_WISP_TWO_EITHER_1a</Page>

      <Page>PH_brevity_WISP_TWO_ECHO_1b</Page>
      <Page>PH_brevity_WISP_TWO_ECHO_2c</Page>
    </Dialogue>
  </DialogueNode>

  <!-- Just Ripple (one of the versions of "TWO") -->
  <DialogueNode>
    <Name>TwoRipple</Name>
    <EntryCondition>PH_BLUE_RIPPLE_P</EntryCondition>
    <Dialogue>
      <Page>PH_brevity_WISP_ONE_1a</Page>
      <Page>PH_brevity_WISP_TWO_EITHER_1a</Page>

      <Page>PH_brevity_WISP_TWO_RIPPLE_1B</Page>
      <Page>PH_brevity_WISP_TWO_RIPPLE_2C</Page>
    </Dialogue>
  </DialogueNode>
        
  <!-- Both Echo and Ripple ("THREE") -->
  <DialogueNode>
    <Name>Three</Name>
    <EntryCondition>PH_BLUE_COMPLETE</EntryCondition>
    <Dialogue>
      <Page>PH_brevity_WISP_ONE_1a</Page>
      <Page>PH_brevity_WISP_TWO_EITHER_1a</Page>
      <Page>PH_brevity_WISP_THREE_1a</Page>

      <Page>PH_brevity_WISP_THREE_2b</Page>
      <Page>PH_brevity_WISP_THREE_3c</Page>
    </Dialogue>

    <RevealFacts>
      <FactID>PH_LOG_BASEMENT_RUMOR_4</FactID>
    </RevealFacts>
  </DialogueNode>
  
</DialogueTree>